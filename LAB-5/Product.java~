public class Product
{
  public String[] name = new String[3];
  public int count = 0;
  public static int[] qty = new qty[3]; 
  public Product(String name, string qty)
  {
    if(count < 3)
    {
      this.name[count] = name;
      this.qty[count] = qty;
      count++;
      System.out.println("Stored: "+name);
    }
    else
    {
      System.out.println("Storage is full! Cannot add.");
    }
  }
  public static void displayProducts()
  {
    System.out.println("=== Stored Products ===");
    System.out.println(this.name[0]+" - QTY: "+this.qty[0]);
    System.out.println(this.name[1]+" - QTY: "+this.qty[1]);
    System.out.println(this.name[2]+" - QTY: "+this.qty[2]);
  }
  public static void buy(String name, int qty)
  {
    for(int i=0; i<count; i++)
    {
      if(this.name[i].equals(name))
      {
        if(this.qty[i] > qty)
        {
          this.qty[i] -= qty;
          System.out.println("Product sold");
          return;
        }
        else
        {
          System.out.println("Quantity low");
          return;
        }
      }
    }
    System.out.println("Product not found");
  }
  
}